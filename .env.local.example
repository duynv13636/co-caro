# Firebase config for Online Play (2-player realtime multiplayer).
#
# 1. Go to https://console.firebase.google.com and create a project (free tier is enough).
# 2. In the project, add a "Web app" — Firebase will show you a config object with these values.
# 3. Enable "Realtime Database" (NOT Firestore) from the left sidebar, in test/locked mode.
# 4. Paste the values below into a new file named .env.local (this file is only a template).
# 5. In the Realtime Database "Rules" tab, paste the rules from README.md so the /rooms path
#    is readable/writable (this app has no login system — rules just scope access to /rooms).
# 6. Restart `npm run dev` after creating .env.local.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
